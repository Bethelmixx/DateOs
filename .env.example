# Neon pooled endpoint (host con -pooler). Obligatorio en Vercel.
DATABASE_URL=

# Better Auth — secreto fijo, mínimo 32 caracteres. Obligatorio en Vercel.
BETTER_AUTH_SECRET=

# URL pública exacta (incluye https). Ej. https://dateos.vercel.app
BETTER_AUTH_URL=https://tu-app.vercel.app

# Opcional: orígenes extra separados por coma (dominio custom, www, etc.)
# BETTER_AUTH_TRUSTED_ORIGINS=https://dateos.app,https://www.dateos.app
